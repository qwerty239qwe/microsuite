docker.enabled = true

// Images are pulled from the registry/tag set in nextflow.config
// (params.container_registry / params.container_tag). Pin container_tag to an
// immutable 'sha-<commit>' tag for a reproducible run.
process {
    withLabel: fastqc {
        container = "${params.container_registry}/fastqc:${params.container_tag}"
    }
    withLabel: multiqc {
        container = "${params.container_registry}/multiqc:${params.container_tag}"
    }
    withLabel: qiime2 {
        container = "${params.container_registry}/qiime2-amplicon:${params.container_tag}"
    }
    withLabel: microsuite {
        container = "${params.container_registry}/microsuite:${params.container_tag}"
    }
    withLabel: microsuite_amplicon {
        container = "${params.container_registry}/prjna321534-alpha:${params.container_tag}"
    }
    withLabel: microsuite_picrust2 {
        container = "${params.container_registry}/microsuite-picrust2:${params.container_tag}"
    }
}
