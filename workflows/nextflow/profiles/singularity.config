singularity.enabled = true
singularity.autoMounts = true

// Pull the same GHCR images as the docker profile via docker:// URIs. Apptainer
// converts each to a local .sif on first use and caches it, so no pre-built
// .sif files need to be shipped. Pin container_tag for a reproducible run.
process {
    withLabel: fastqc {
        container = "docker://${params.container_registry}/fastqc:${params.container_tag}"
    }
    withLabel: multiqc {
        container = "docker://${params.container_registry}/multiqc:${params.container_tag}"
    }
    withLabel: qiime2 {
        container = "docker://${params.container_registry}/qiime2-amplicon:${params.container_tag}"
    }
    withLabel: microsuite {
        container = "docker://${params.container_registry}/microsuite:${params.container_tag}"
    }
    withLabel: microsuite_amplicon {
        container = "docker://${params.container_registry}/prjna321534-alpha:${params.container_tag}"
    }
    withLabel: microsuite_picrust2 {
        container = "docker://${params.container_registry}/microsuite-picrust2:${params.container_tag}"
    }
}
