manifest {
    name = 'microsuite/amplicon'
    author = 'microsuite contributors'
    description = 'microsuite amplicon and microsuite-native Nextflow workflows'
    version = '0.1.0'
    mainScript = 'main.nf'
    // Fail fast on engines the pipeline was not written/tested against.
    nextflowVersion = '>=25.10.0'
}

params {
    workflow = 'amplicon_qiime2'
    outdir = 'results'
    threads = 2
    trim_left = 0
    trunc_len = 0
    trim_left_f = 0
    trunc_len_f = 0
    trim_left_r = 0
    trunc_len_r = 0
    sampling_depth = 1000
    trim = true
    fastp_cpus = 4
    fastp_args = ''

    // PICRUSt2 defaults to the v2.6+ PICRUSt2-SC dual-domain database. Leave
    // optional custom paths unset to preserve the historical two-input run.
    picrust2_database = 'SC'
    picrust2_ref_dir1 = null
    picrust2_ref_dir2 = null
    picrust2_custom_trait_tables_ref1 = []
    picrust2_custom_trait_tables_ref2 = []
    picrust2_marker_gene_table_ref1 = null
    picrust2_marker_gene_table_ref2 = null
    picrust2_pathway_map = null
    picrust2_reaction_func = null
    picrust2_regroup_map = null
    picrust2_max_nsti = null
    picrust2_no_pathways = false
    picrust2_coverage = false
    picrust2_no_regroup = false

    // Container source. Images are published to GHCR by the Docker CI workflow.
    // For a reproducible run, pin container_tag to an immutable tag (a
    // 'sha-<commit>' tag is pushed for every build) instead of the 'latest'
    // default, e.g. -c ... --container_tag sha-0dd0ae6.
    container_registry = 'ghcr.io/qwerty239qwe/microsuite'
    container_tag = 'latest'
}

profiles {
    local {
        includeConfig 'profiles/local.config'
    }
    docker {
        includeConfig 'profiles/docker.config'
    }
    singularity {
        includeConfig 'profiles/singularity.config'
    }
}
