params {
    workflow = 'amplicon_qiime2'
    outdir = 'results'
    threads = 2
    trim_left = 0
    trunc_len = 0
    trim_left_f = 0
    trunc_len_f = 0
    trim_left_r = 0
    trunc_len_r = 0
    sampling_depth = 1000
}

profiles {
    local {
        includeConfig 'profiles/local.config'
    }
    docker {
        includeConfig 'profiles/docker.config'
    }
    singularity {
        includeConfig 'profiles/singularity.config'
    }
}
